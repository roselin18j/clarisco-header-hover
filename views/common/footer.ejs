function generateCaptcha() {
var num1 = Math.floor(Math.random() * 10);
var num2 = Math.floor(Math.random() * 10);

document.getElementById('num1').textContent = num1;
document.getElementById('num2').textContent = num2;
}

// Validate the CAPTCHA when the form is submitted
function validateCaptcha(event) {
event.preventDefault();

var captchaInput = document.getElementById('captcha');
var userAnswer = parseInt(captchaInput.value);
var num1 = parseInt(document.getElementById('num1').textContent);
var num2 = parseInt(document.getElementById('num2').textContent);

// Calculate the expected sum
var expectedSum = num1 + num2;

// Check if the user's answer is correct
if (userAnswer === expectedSum) {
  // alert('CAPTCHA is correct!');
  // You can add additional form submission logic here
} else {
  // alert('CAPTCHA is incorrect. Please try again.');
  // Reset the CAPTCHA
  captchaInput.value = '';
  generateCaptcha();
}
}

// Generate the initial CAPTCHA when the page loads
generateCaptcha();

// Attach the form submission event listener
var form = document.querySelector('form');
form.addEventListener('submit', validateCaptcha);
</script>
