<%- include('../common-new/header') %>

  <body>

    <%- include('../common-new/navbar') %>

        <section class="double-alt-case-study-002">
          <div class="container-fluid whole-case-clr-01">
            <div class="row site-banner-min-height-desktop align-items-center col-lg-11 position-relative mx-auto">
              <div class="col-8 mx-auto d-lg-none forward-image  d-block pt-5">
                <div class="boxing-top-shadowing  position-absolute" style="background-color: white;"></div>
                <img src="https://assets.clarisco.com/clarisco-images/cryptopage/new-robo-001.webp" alt="commodity-tokenization" title="commodity-tokenization">
              </div>
              <div class="col-lg-8">
                <h1 class="casestudies-banner-ctn-001  tot-all-child-vw-01" data-aos="fade-up">COMMODITY TOKENIZATION 
                  SELLING PLATFORM</h1>
                  <p class="nft-new-text-2 mt-lg-3 w-100" data-aos="fade-up">Find out How We Made Solutions Successfully for Commodity Tokenization<br/> Platform with our Expertise.
                  </p>
                  <button class="bg-transparent border-0">
                    <button data-bs-toggle="modal" data-bs-target="#PopForm" class="mt-3 swiper-left-1 nft-new-banner-button-1 nft-new-banner-button-x10">Learn
                      More</button>
                  </button>
              </div>
  
            </div>
          </div>
        </section>

        <section class="new-top-banner-section-6">
          <div class="container-fluid col-lg-10 position-relative">
            <div class="nft-new-glow-bg-5" style="background-color: #b53ff6;"></div>
            <div class="row g-4 align-items-center flex-lg-row-reverse">
              <div class="col-lg-6 text-end alt-nnn-commodity-img">
                <img rel="preload" class="Industries-home-new-image h-auto" 
                  src="https://assets.clarisco.com/clarisco-images/case-study/case-study-banner-3.webp" alt="commodity-problem" title="commodity-problem" style="width: 60%;" />
              </div>
              <div class="col-lg-6 new-case-study-banner-home" style="background-image: none;">
                <h5 class="new-prob-ctn-x fw-bold custom-headingsize text-white text-capitalize tot-all-child-vw" >problem</h5>

                <p class="nft-new-text-2 mt-lg-3 text-justify w-100" >The client needed a secure platform to sell commodities-backed cryptocurrencies and tokens while ensuring that sensitive information, such as private keys, was not stored on their servers. The platform had to support multiple cryptocurrencies and tokens, include robust security features, and offer an intuitive user experience.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="new-case-study-banner-home-4 py-5">
          <div class="container">
            <div class="row align-items-center g-4 justify-content-around new-case-study-banner-home" style="background-image: none;">
              <h5 class="custom-headingsize text-center fw-bold new-prob-ctn-x tot-all-child-vw">
                Client’s Demand
                </h5>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Security :</span> No storage of private keys on the server.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Multi-cryptocurrency and token support :</span> Integration with multiple blockchain networks.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Admin control :</span> A system where the admin has control over deposits and withdrawals without compromising security.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">User authentication and verification :</span> Comprehensive KYC processes.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">User-friendly admin panel :</span> Easy management of the platform’s functionalities.
              
              </div>
          
            </div>
          </div>
        </section>
          
        <section class="py-5" style="background-color: rgb(23,8,31);">
          <div class="container-fluid col-lg-10 position-relative new-case-study-banner-home"
            style="background-image: none;">
            <div class="nft-new-glow-bg-5" style="background-color: #b53ff6;opacity: 0.9;z-index: -1;"></div>
            <h5 class="fw-bold mb-4 custom-headingsize text-center mx-auto new-prob-ctn-x tot-all-child-vw" >Upshots</h5>

            <p class="new-case-study-text-1 col-lg-10" >The implementation of this platform resulted in a highly secure, user-friendly, and efficient commodities-backed cryptocurrency/token selling platform. The client’s requirements for security, multiple cryptocurrency support, and robust admin controls were met effectively. The integration of automated processes like "Move to Admin" and manual approval systems for withdrawals ensured that the platform remained secure while providing flexibility and control to the admin.</p>
          </div>
        </section>

        <section class="new-case-study-banner-home-2 py-5 position-relative overflow-hidden">
          <div>
            <div class="nft-new-glow-bg-1 custom-centertheme"
              style="background-color: #39708462; top:5vw; left:-9vw; width:600px; height:500px; filter: blur(180px);">
            </div>
            <div class="nft-new-glow-bg-1 custom-centertheme"
              style="background-color: #7a15623d; top:5vw; right:-9vw; width:900px; height:500px; filter: blur(80px);">
            </div>

            <div class="container">

              <div class="new-case-study-banner-home" style="background-image: none;">
                <h5 class="fw-bold text-center new-prob-ctn-x custom-headingsize mx-auto tot-all-child-vw" >Technology Stack</h5>


                <div class="row row-cols-1 row-cols-md-3 g-4 my-5">
                  <div class="col">
                    <div class="card text-center new-case-study-card-1">
                      <div class="card-body">
                        <img src="https://assets.clarisco.com/clarisco-images/case-study/nodejs.webp" class="new-case-study-img-1 new-case-study-img-w-w" alt="nodeJS" title="nodeJS">
                        <img src="https://assets.clarisco.com/clarisco-images/case-study/nodejs-color.webp" class="new-case-study-img-1 new-case-study-img-w-c" alt="nodeJS" title="nodeJS">
                        <p>Node JS</p>
                      </div>
                      <p class="mt-1 mb-3  mx-auto text-center swiper-left-1 nft-new-banner-button-1 nft-new-banner-button-x10">
                        Backend</p>
                    </div>
                   
                    
                  </div>
                  <div class="col">
                    <div class="card text-center new-case-study-card-2">
                      <div class="card-body">
                        <img src="https://assets.clarisco.com/clarisco-images/case-study/Reactjs.webp" class="new-case-study-img-1 new-case-study-img-w-w" alt="reactJS" title="reactJS">
                        <img src="https://assets.clarisco.com/clarisco-images/case-study/Reactjs-color.webp" class="new-case-study-img-1 new-case-study-img-w-c" alt="reactJS" title="reactJS">
                        <p>React JS</p>
                      </div>
                      <p class="mt-1 mb-3  mx-auto text-center swiper-left-1 nft-new-banner-button-1 nft-new-banner-button-x10">
                        Frontend & Admin Panel</p>
                    </div>
                   
                    
                  </div>
                  <div class="col">
                    <div class="card text-center new-case-study-card-3">
                      <div class="card-body">
                        <img src="https://assets.clarisco.com/clarisco-images/case-study/mangodp.webp" class="new-case-study-img-1 new-case-study-img-w-w" alt="mongoDB" title="mongoDB">
                        <img src="https://assets.clarisco.com/clarisco-images/case-study/mangodb-color.webp" class="new-case-study-img-1 new-case-study-img-w-c" alt="mongoDB" title="mongoDB">
                        <p>MongoDB</p>
                      </div>
                      <p class="mt-1 mb-3  mx-auto text-center swiper-left-1 nft-new-banner-button-1 nft-new-banner-button-x10">
                        Database</p>
                    </div>
                  
                   
                  </div>
                  
                </div>


                <p class="nft-new-text-2 mt-lg-3 text-justify text-center w-100" >The platform's technology stack includes Node.js for the backend, React.js for the frontend and admin panel, and MongoDB for the database. It integrates networks for tokens like BEP20 (USDT, DUSD) and coins such as ETH, BTC, and Polygon.</p>

              </div>
            </div>
          </div>
        </section>
        
        <section class="new-case-study-banner-home-4 py-5">
          <div class="container">
            <div class="row align-items-center g-4 justify-content-around new-case-study-banner-home"
              style="background-image: none;">
              <h5 class="custom-headingsize text-center fw-bold new-prob-ctn-x tot-all-child-vw" >
                Key Features
                </h5>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Push to Burn :</span>  A mechanism to remove tokens from circulation.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Move to Admin :</span> Automated transfer of deposits to the admin address every 12 hours.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Admin 2FA :</span> Two-factor authentication for admin access.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Sub Admin Customization :</span> Ability to add or remove sub-admins.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Admin Withdraw :</span> Admin-controlled withdrawal processes.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Deposit Withdraw :</span> User-initiated deposits and withdrawals.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Google Authentication :</span> Integration with Google for enhanced security.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">KYC :</span>  Users must submit their International Driving Licence or Passport for verification.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Product List Management :</span> Admins can upload and manage product lists.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Live Visit Booking & Product Delivery :</span>
                Features to facilitate direct interactions and deliveries.
              </div>

            </div>
          </div>
        </section>
        
        <section class="new-case-study-banner-home-4 py-5">
          <div class="container">
            <div class="row align-items-center g-4 justify-content-around new-case-study-banner-home" style="background-image: none;">
              <h5 class="fw-bold custom-headingsize text-center mb-2 new-prob-ctn-x tot-all-child-vw">Modules &amp; Industrial Part</h5>
              <h5 class="nft-new-text-2 mt-lg-3 text-justify text-start mb-0 w-100 alt-case-study-security tot-all-child-vw">Security Implementation</h5>

              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Move to Admin :</span> The platform employs an automated system where user deposits are transferred to an admin-specified address every 12 hours. This process is executed using a cron job, ensuring that private keys are never stored on the server, thus adhering to the client's security requirements.
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">
                  Withdraw
                   :</span> For withdrawals, users' requests are sent to the admin. Upon approval, the requested amount is transferred manually from the admin's address to the user's address. This manual process adds an extra layer of security, preventing unauthorized access.

              </div> 
              <h5 class="nft-new-text-2 mt-lg-5 text-justify text-start mb-0 w-100 alt-case-study-security tot-all-child-vw">User Authentication</h5>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">Google Authentication : </span> Ensures that users have an additional layer of security when accessing their accounts.
                
              </div>
              <div class="new-case-study-banner-home-4-list-items">
                <span style="color: #c65bd1;font-weight: 800;">KYC :</span> Users must submit their International Driving Licence or Passport, providing a reliable method of identity verification to prevent fraud.  
              </div>
            </div>
          </div>
        </section>

        <section>
          <div class="row">
            <div class="col-lg-10 mx-auto">
              <div class="new-case-study-text-1 mt-5">
                <h5 class="mb-4 fw-bold text-center new-prob-ctn-x text-white tot-all-child-vw">Conclusion</h5>
                <p class="text-center">This commodities-backed cryptocurrency/token selling platform exemplifies how modern technologies and thoughtful design can create secure, user-friendly financial solutions. By leveraging a robust technology stack and implementing stringent security measures, the platform successfully meets the client’s demands, ensuring a seamless and secure user experience.</p>
                  
              </div>
            </div>
          </div>
        </section>

