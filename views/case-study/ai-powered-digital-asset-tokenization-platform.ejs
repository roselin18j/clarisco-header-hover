            <h2 class="nw-w-head-1 mb-3 mt-5" data-aos="fade-up">Asset Classes We Tokenized</h2>

            <section class="nw-banner-sec-3 pb-5">
                <div class="container-fluid col-lg-10">
                    <div class="row justify-content-between align-items-center g-4">
                        <div class="col-xl-5 col-md-5 col-8 mx-auto">
