  <div class="col-lg-12">
    <div class="input-group new-contact-form-section">
      <span class="input-group-text"> <span><i class="fa-solid fa-list"></i></span></span>
      <select class="form-select" name="requirement" id="requirement" aria-label="Default select example">
        <option value="" selected hidden>Select your services</option>
        <option value="ai_ml_development">AI & ML Development Services</option>
        <option value="crypto_exchange_development">Crypto Exchange Development Services</option>
        <option value="blockchain_development">Blockchain Development Services</option>
        <option value="rwa_tokenization_development">RWA Tokenization Platform Development</option>
        <option value="prediction_market_platform_development">Prediction Market Platform Development</option>
        <option value="ico_ieo_sto_development">ICO / IEO / STO Development Services</option>
        <option value="crypto_wallet_development">Crypto Wallet Development Services</option>
        <option value="trading-bot-development">Trading Bot Development</option>
        <option value="game_development">Game Development Services</option>
        <option value="defi_development">DeFi Development Services</option>
        <option value="banking_software_development">Banking Software Development</option>
        <option value="web_mobile_app_development">Custom Web & Mobile App Development</option>
        <option value="ar_vr_vfx_services">AR / VR / VFX Services</option>
        <option value="business_consulting">Business Consulting Services</option>
        <option value="hire-dedicated-developers">Hire Dedicated Developers / Resources</option>
        <option value="others">Other (Please Specify)</option>
      </select>
      <small id="requirement-error" class="text-danger"></small>
    </div>
  </div>

  <div class="col-lg-12">
    <div class="input-group new-contact-form-section align-items-start">
      <span class="input-group-text pt-0"> <span><i class="fa-solid fa-square-pen"></i></span></span>
      <textarea id="message" name="message" class="form-control form-control-new-contact" autocomplete="off"
        placeholder="Write Your Requirements.." style="height: 100px;width: auto;"></textarea>
    </div>
  </div>

  <div class="col-lg-12">
    <div id="recaptcha-container"></div>
    <div class="loader-button position-relative d-flex">
      <button class="contact-new-form-button" id="contact_submit_btn">
        submit<i class="fa-solid fa-angle-right"></i>
      </button>
      <div class="spinner-border position-relative spinning-rotator" role="status">
        <span class="sr-only">Loading...</span>
      </div>
    </div>
