<form class="new-contact-form row" name="footercontact" id="footercontact" autocomplete="off">

  <div class="col-lg-6">
    <div class="input-group new-contact-form-section align-items-center">
      <span class="input-group-text"> <span><i class="fa-solid fa-user"></i></span></span>
      <input type="text" class="form-control form-control-new-contact" placeholder="Enter Your Name"
        aria-label="footercontact" name="name" autocomplete="off">
    </div>
  </div>

  <div class="col-lg-6">
    <div class="input-group new-contact-form-section align-items-center">
      <span class="input-group-text"> <span><i class="fa-solid fa-envelope"></i></span></span>
      <input type="email" name="email" class="form-control form-control-new-contact" placeholder="Enter Your Email"
        aria-label="Name" autocomplete="off">
    </div>
  </div>

  <div class="col-lg-6 country-sel">
    <div class="input-group new-contact-form-section d-flex flex-row new-contact-form-section-country">
      <span class="input-group-text"> <span><i class="fa-solid fa-globe"></i></span></span>
      <input type="text" id="country_selector" name="country_selector" autocomplete="off"
        class="form-control-new-contact-2 me-auto" placeholder="Enter Your Country" value="">
    </div>
  </div>

  <div class="col-lg-6 country-sel-2">
    <div class="input-group new-contact-form-section d-flex flex-row new-contact-form-section-country">
      <span class="input-group-text"> <span><i class="fa-solid fa-phone"></i></span></span>
      <input class="form-control-new-contact-2 pt-2 w-100" type="tel" id="mob_phone" aria-label="Name"
        autocomplete="off" name="mob_phone" placeholder="Enter Mobile Number">
      <input type="hidden" name="phone" id="phone" />
    </div>
  </div>

