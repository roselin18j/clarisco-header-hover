                          </button>
                        </h2>

                        <div id="flush-collapse-<%= index %>" class="accordion-collapse collapse">
                          <div class="accordion-body d-flex align-items-center gap-3 ps-5">
                            <i class="fa-solid fa-circle-right fs-4" style="color: #7b7fe6;"></i>
                            <span style="color: #000000a2;">
                              <%= item.content %>
                            </span>
                          </div>
                        </div>
                      </div>
