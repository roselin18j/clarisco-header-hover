                            <script>
                              document.addEventListener("DOMContentLoaded", () => {

                                let clickedNav = false;

                                document.querySelectorAll(".float-link").forEach(link => {

                                  link.addEventListener("click", function (e) {
                                    e.preventDefault();
                                    clickedNav = true;

                                    // remove old active section
                                    document.querySelectorAll(".ma-top").forEach(el => {
                                      el.classList.remove("ma-top");
                                    });

                                    const targetId = this.getAttribute("data-target");
                                    const target = document.getElementById(targetId);

                                    if (target) {
                                      target.classList.add("ma-top");

                                      target.scrollIntoView({
                                        behavior: "smooth",
                                        block: "start"
                                      });
                                    }

                                    // allow scroll handler after anchor jump completes
                                    setTimeout(() => {
                                      clickedNav = false;
                                    }, 500);
                                  });

                                });

                                window.addEventListener("wheel", () => {

                                  if (!clickedNav) {
                                    document.querySelectorAll(".ma-top").forEach(el => {
                                      el.classList.remove("ma-top");
                                    });
                                  }

                                });

                                window.addEventListener("touchmove", () => {

                                  if (!clickedNav) {
                                    document.querySelectorAll(".ma-top").forEach(el => {
                                      el.classList.remove("ma-top");
                                    });
                                  }

                                });

                              });
                            </script>
                            <script>
                              const floatingNav = document.getElementById("floatingNav");
                              let hideTimer;

                              function showNav() {
                                floatingNav.classList.remove("hide");

                                clearTimeout(hideTimer);
                                hideTimer = setTimeout(() => {
                                  floatingNav.classList.add("hide");
                                }, 2000); // Hide after 2 seconds of inactivity
                              }

                              // Show on mouse movement
                              document.addEventListener("mousemove", showNav);

                              // Optional: Also show on touch devices
                              document.addEventListener("touchstart", showNav);

                              // Start the timer when the page loads
                              showNav();
                            </script>
                            <script>
