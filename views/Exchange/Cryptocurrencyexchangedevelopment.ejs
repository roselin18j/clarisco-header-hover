            <div class="col">
              <h2 class="nwe-toke-txt-4 mb-3 text-center" data-aos="fade-up">
                Cryptocurrency Exchange <span class="curve-text">Software</span> Development
              </h2>
              <p class="nw-w-txt-2 text-center mb-3" data-aos="fade-up">Clarisco
                Cryptocurrency exchange software is a trading platform that enables users to buy, sell, and trade
                digital
                assets such as BTC, ETH, and USDT. These platforms support multiple trading models, including
                centralized
                exchanges (CEX), decentralized exchanges (DEX), and hybrid exchange systems.
              </p>
              <p class="nw-w-txt-2 text-center mb-3" data-aos="fade-up">
                Crypto exchange development services typically include trading engines, wallet integration,
                liquidity
                management, security systems, and administrative tools required to operate a digital asset trading
                platform.
              </p>
              <p class="nw-w-txt-2 text-center mb-3" data-aos="fade-up">
                Clarisco's exchange stack includes a custom-built matching engine, multi-chain wallet integration
                (Ethereum, BNB Chain, Solana, Polygon, Tron), automated liquidity bridging, HSM-protected key
                management,
                and a white-label admin panel with real-time risk controls.
              </p>
              <div data-aos="fade-up" class="mt-5 col-md-7 mx-auto">
                <img src="https://assets.clarisco.com/cryptocurrency-img/crypto-exchange-img.webp"
                  alt="Digital Asset tokenization" class="img-fluid" loading="lazy" />
              </div>
              <!-- <div class="d-flex flex-row align-items-center justify-content-center mt-5 gap-2"
                                    data-aos="fade-up">
                                    <button class="nw-w-btn-1" data-bs-toggle="modal" data-bs-target="#PopForm">
                                        Book a Free Demo
                                    </button>
                                </div> -->
            </div>
          </div>
        </div>
      </section>

      <% const accordionData=[ { title: "I have an idea… but where do I even start?" ,
        content: "Book a call with our founder directly. We map your exchange type, target market, compliance requirements, and feature set in one session — and hand you a project roadmap before the call ends."
        }, { title: "By the time I build this, the market might move on" ,
        content: "Our white-label foundation gets you live in as little as 9 days. Custom builds average 11 weeks — compared to 6 months with traditional vendors or 14 weeks with most white-label providers."
        }, { title: "What if users join… but don’t trade?" ,
        content: "We integrate automated liquidity bridging, trading bot support, and market-making APIs at the infrastructure level — not as add-ons. Your exchange has depth from day one."
        }, { title: "One security breach… and everything I built is gone" ,
        content: "Every exchange we ship is penetration-tested by independent certified ethical hackers, smart contract audited by two separate firms, and monitored in real time. In over a decade, zero client exchanges have been compromised."
        }, { title: "Regulations feel like a trap… what if I get it wrong?" ,
        content: "We've successfully cleared compliance across 32 jurisdictions. KYC/AML, GDPR, FATF Travel Rule — our compliance framework is built into the platform, not bolted on after launch."
        }, { title: "I don’t have a tech team… how will I manage this after launch?" ,
        content: "You get 24/7 engineering support with real engineers, not ticket queues. We handle security patches, blockchain upgrades, and performance monitoring. You own 100% of the source code and control your platform's future."
        }, { title: "Everyone is building an exchange… how do I stand out?" ,
        content: "Most exchanges look identical because they use the same scripts. We build custom UI, your brand identity, and AI-native features — copy trading, prediction markets, trading bots — that the typical white-label provider doesn't offer."
        } ]; %>

        <section class="pb-5">
          <div class="container-fluid col-lg-10 position-relative nwe-toke-sec-3">
            <div class="nwe-toke-sec-3-1">
              <h2 class="nwe-toke-txt-4 mb-lg-5 mb-3 text-center" data-aos="fade-up">
                Real Struggles Founders Face & How Clarisco Solves the Problem

              </h2>
              <div class="row justify-content-center">
                <div class="col-lg-9 nwe-toke-sec-3-2">
                  <div class="accordion accordion-flush custom-accordion w-100" id="accordionFlushExample"
                    data-aos="fade-up">
                    <% accordionData.map((item, index)=> { %>
                      <div class="accordion-item" onmouseenter="scheduleOpen('flush-collapse-<%= index %>', this)"
                        onmouseleave="cancelOpen()">
                        <h2 class="accordion-header">
                          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#flush-collapse-<%= index %>" aria-expanded="false">
                            <img src="https://assets.clarisco.com/assets/rwa-nw/q.png" alt="question" class="img-fluid"
                              style="width: 24px;" loading="lazy" width="24" height="24" />
                            <%= item.title %>
                              <i class="fa-solid fa-arrow-right ms-auto"></i>
                          </button>
                        </h2>

                        <div id="flush-collapse-<%= index %>" class="accordion-collapse collapse">
                          <div class="accordion-body d-flex align-items-center gap-3 ps-5">
                            <i class="fa-solid fa-circle-right fs-4" style="color: #7b7fe6;"></i>
                            <span style="color: #000000a2;">
                              <%= item.content %>
                            </span>
                          </div>
                        </div>
                      </div>
                      <% }) %>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </section>

