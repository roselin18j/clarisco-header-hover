                              function renderTechCards(tabId) {
                                const container = document.getElementById(`cards-${tabId}`);
                                if (!container || !tabCardsData2[tabId]) return;

                                container.innerHTML = ""; // Clear previous cards

                                tabCardsData2[tabId].forEach(card => {
                                  const col = document.createElement("div");
                                  col.className = "col";

        col.innerHTML = `<div class="card">
                                                                                <div class="card-body d-flex flex-column justify-content-center">
                                                                                <div class="text-center mb-3">
                                                                                <img src="${card.img}" alt="${card.title}" loading="lazy" 
                                                                                          style="${['Express JS', 'App.JS', 'HyperLedger', 'Proton Native', 'Truffle', 'Remix'].includes(card.title)
                                                                    ? 'filter:invert(1);'
                                                                    : ''}">
                                                                                </div>
                                                                            <p class="text-center mb-0">${card.title}</p>
                                                                        </div>
                                                                     </div>
                                                                              `;

                                  container.appendChild(col);
                                });
                              }

                              // Initial load for active tab
                              renderTechCards("pills-t-1-1");

                              // Attach event listeners to render tech stack cards on tab change
                              document.querySelectorAll('#tech-pills-tab [data-bs-toggle="pill"]').forEach(button => {
                                button.addEventListener("shown.bs.tab", (e) => {
                                  const targetId = e.target.getAttribute("data-bs-target").replace("#", "");
                                  renderTechCards(targetId);
                                });
                              });
