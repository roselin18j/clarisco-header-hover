<!-- ============================================================
     LAZY MEGA MENU LOADER
     Fetches /partials/mega-menu ONCE on first hover.
     Until then: zero bytes of mega menu HTML in the page.
     AI crawlers never execute this — they see only the 
     lightweight static nav above.
     ============================================================ -->
<script>
    (function () {
        var megaLoaded = false;

        function loadMegaMenu() {
            if (megaLoaded) return;
            megaLoaded = true;

            fetch('/partials/mega-menu')
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    // Inject full mega menu HTML into both placeholders
                    var temp = document.createElement('div');
                    temp.innerHTML = html;

                    var servicesMega = temp.querySelector('#mega-services-content');
                    var productsMega = temp.querySelector('#mega-products-content');

                    var servicesPlaceholder = document.getElementById('services-mega-placeholder');
                    var productsPlaceholder = document.getElementById('products-mega-placeholder');

                    if (servicesMega && servicesPlaceholder) {
                        servicesPlaceholder.innerHTML = servicesMega.innerHTML;
                    }
                    if (productsMega && productsPlaceholder) {
                        productsPlaceholder.innerHTML = productsMega.innerHTML;
                    }

                    // Re-init click handlers after inject
                    initMegaMenuClicks();
                    initImageSwitchers();
                })
                .catch(function (err) {
                    console.warn('Mega menu failed to load:', err);
                });
        }

        // Trigger on hover over Services or Product nav items
        ['services-nav-item', 'products-nav-item'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) {
                el.addEventListener('mouseenter', loadMegaMenu, { once: true });
                el.addEventListener('touchstart', loadMegaMenu, { once: true });
            }
        });

        // Fallback: load after 4 seconds (covers mobile, slow interactions)
        setTimeout(loadMegaMenu, 4000);

        // ── Re-init click handlers for mega menu after it's injected ──
        function initMegaMenuClicks() {
            var navItems = document.querySelectorAll('.click-menu-item');
            var activeMenu = null;

            navItems.forEach(function (navItem) {
                var megaMenu = navItem.querySelector('.megamenu');
                if (!megaMenu) return;

                navItem.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (activeMenu === megaMenu) {
                        megaMenu.style.display = 'none';
                        activeMenu = null;
                    } else {
                        if (activeMenu) activeMenu.style.display = 'none';
                        megaMenu.style.display = 'block';
                        activeMenu = megaMenu;
                    }
                });

                megaMenu.addEventListener('click', function (e) {
                    e.stopPropagation();
                });

                // Scroll lock on hover (desktop)
                megaMenu.addEventListener('mouseenter', function () {
                    document.body.style.overflow = 'hidden';
                    document.body.style.paddingRight = '8px';
                });
                megaMenu.addEventListener('mouseleave', function () {
                    document.body.style.overflow = 'scroll';
                    document.body.style.paddingRight = '0px';
                });
            });

            document.addEventListener('click', function () {
                if (activeMenu) {
                    activeMenu.style.display = 'none';
                    activeMenu = null;
                }
            });
        }

        // ── Re-init image switchers (section-1, section-2) after inject ──
        function initImageSwitchers() {
            document.querySelectorAll('.section-1 .show-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.section-1 .image-container').forEach(function (img) {
                        img.style.display = 'none';
                    });
                    var target = document.querySelector(btn.getAttribute('data-target'));
                    if (target) target.style.display = 'block';
                });
            });
            document.querySelectorAll('.section-2 .show-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.section-2 .image-container').forEach(function (img) {
                        img.style.display = 'none';
                    });
                    var target = document.querySelector(btn.getAttribute('data-target'));
                    if (target) target.style.display = 'block';
                });
            });
        }

    })();
</script>

