                $(".top-newbar-section .navbar").css("background-color", "#ffffff1c");
            }
        });
    });
</script>

<!-- Sidebar open/close -->


<!-- Tab LocalStorage -->
<script>
    $(document).ready(function () {

        let modalOpen = false;

        // ===========================
        // DESKTOP SIDEBAR
        // ===========================

        function openSidebar() {
            $('#uniqueSidebar').css('right', '0');
            $('#uniqueOverlay').addClass('active');
            $('body').addClass('over-hid').css('overflow', 'hidden');
        }

        function closeSidebar() {

            if (modalOpen) return;

            $('#uniqueSidebar').css('right', '-300px');
            $('#uniqueOverlay').removeClass('active');

            // Remove body class only if mobile offcanvas is also closed
            if (!$('#offcanvasWithBothOptions').hasClass('show')) {
                $('body').removeClass('over-hid').css('overflow', '');
            }
        }

        // Open Desktop Sidebar
        $('#openSidebar').on('click', function (e) {
            e.stopPropagation();
            openSidebar();
        });

        // Close Desktop Sidebar
        $('#closeSidebar, #uniqueOverlay').on('click', function (e) {
            e.stopPropagation();
            closeSidebar();
        });

        // Prevent clicks inside desktop sidebar
        $('#uniqueSidebar').on('click', function (e) {
            e.stopPropagation();
        });

        // Keep sidebar open for Pitch Deck
        $('.nav-pitch-link').on('click', function (e) {
            e.stopPropagation();
        });

        // Click outside desktop sidebar
        $(document).on('click', function (e) {

            if (modalOpen) return;

            if (
                $(e.target).closest('#uniqueSidebar').length ||
                $(e.target).closest('#openSidebar').length
            ) {
                return;
            }

            closeSidebar();

        });

        // ===========================
        // MOBILE OFFCANVAS
        // ===========================

        $('#offcanvasWithBothOptions').on('shown.bs.offcanvas', function () {
            $('body').addClass('over-hid').css('overflow', 'hidden');
        });

        $('#offcanvasWithBothOptions').on('hidden.bs.offcanvas', function () {

            if (!modalOpen) {
                $('body').removeClass('over-hid').css('overflow', '');
            }

        });

        // ===========================
        // PITCH DECK MODAL
        // ===========================

        $('#staticBackdrop').on('show.bs.modal', function () {
            modalOpen = true;
        });

        $('#staticBackdrop').on('shown.bs.modal', function () {
            $('body').addClass('over-hid').css('overflow', 'hidden');
        });

        $('#staticBackdrop').on('hidden.bs.modal', function () {

            modalOpen = false;

            setTimeout(function () {

                // Desktop sidebar open
                if ($('#uniqueSidebar').css('right') === '0px') {
                    $('body').addClass('over-hid').css('overflow', 'hidden');
                }

                // Mobile offcanvas open
                if ($('#offcanvasWithBothOptions').hasClass('show')) {
                    $('body').addClass('over-hid').css('overflow', 'hidden');
                }

            }, 100);

        });

    });
</script>