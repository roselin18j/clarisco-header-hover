<script>
    $(document).ready(function () {

        function updateBodyClass() {
            if ($('.service-content').is(':visible') || $('.product-content').is(':visible')) {
                $('body').addClass('over-hid');
            } else {
                $('body').removeClass('over-hid');
            }
        }

        $('.service-link').click(function () {
            $('.service-content').toggle();
            $('.product-content').hide();
            updateBodyClass();
        });

        $('.product-link').click(function () {
            $('.product-content').toggle();
            $('.service-content').hide();
            updateBodyClass();
        });

        $('.whole-close-service').click(function () {
            $('.service-content').hide();
            updateBodyClass();
        });

        $('.whole-close-product').click(function () {
            $('.product-content').hide();
            updateBodyClass();
        });

        // Close when clicking outside
        $(document).click(function (event) {
            var target = $(event.target);

            if (!target.closest('.service-content, .service-link').length) {
                $('.service-content').hide();
            }

            if (!target.closest('.product-content, .product-link').length) {
                $('.product-content').hide();
            }

            updateBodyClass();
        });

    });
</script>

<script>
    let buttonStack = [];

    $(document).ready(function () {
        $(".btn-w").click(function () {
            $(".button-content").addClass("d-none");
            $(".btn-w").addClass("d-none");
            $(".back-btn").removeClass("d-none");
            const buttonId = $(this).attr("id");
            const contentId = `${buttonId}-content`;
            const contentToShow = $(`#${contentId}`);
            if (contentToShow.length > 0) {
                contentToShow.removeClass("d-none");
                buttonStack.push(buttonId);
            }
        });

        $(".btn-w-1").click(function () {
            $(".btn-w-1").addClass("d-none");
            const buttonId = $(this).attr("id");
            const contentId = `${buttonId}-content`;
            const contentToShow = $(`#${contentId}`);
            if (contentToShow.length > 0) {
                contentToShow.removeClass("d-none");
                buttonStack.push(buttonId);
            }
        });

        $(".back-btn").click(function () {
            if (buttonStack.length > 0) {
                const lastButtonId = buttonStack.pop();
                const lastContentId = `${lastButtonId}-content`;
                $(`#${lastContentId}`).addClass("d-none");

                // Show the previous content and buttons
                if (buttonStack.length > 0) {
                    const prevButtonId = buttonStack[buttonStack.length - 1];
                    const prevContentId = `${prevButtonId}-content`;
                    $(`#${prevContentId}`).removeClass("d-none");

                    // Show buttons based on their levels
                    if (prevButtonId.includes('-')) {
                        $(".btn-w-1").removeClass("d-none");
                    } else {
                        $(".btn-w").removeClass("d-none");
                    }
                } else {
                    $(".btn-w").removeClass("d-none");
                    $(".back-btn").addClass("d-none");
                }
            }
        });
    });
</script>


