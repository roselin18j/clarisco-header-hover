    <script>
      function toggleTawk() {
        const iframe = document.querySelector(".my-tawk-iframe");

        if (!iframe) return;

        const wrapper = iframe.closest("div");

        if (document.body.classList.contains("over-hid")) {
          wrapper.style.setProperty("z-index", "-1", "important");
        } else {
          wrapper.style.removeProperty("z-index");
        }
      }

      const observer = new MutationObserver(toggleTawk);

      observer.observe(document.body, {
        attributes: true,
        attributeFilter: ["class"]
      });

      // Initial check
      toggleTawk();
    </script>

