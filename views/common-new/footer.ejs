      const input = $('#meta_itemcondition');

      let placeholderText = 'Enter Contact Info';

      switch (selectedValue) {
        case 'Whatsapp':
          placeholderText = 'Enter Whatsapp Number';
          break;
        case 'Telegram':
          placeholderText = 'Enter Telegram Username';
          break;
        case 'Teams':
          placeholderText = 'Enter Teams Username';
          break;
        case 'Others':
          placeholderText = 'Enter Other Contact Info';
          break;
      }

      // Update placeholder
      input.attr('placeholder', placeholderText);

      // Update icon and color
      iconEl.attr('class', `bi ${selectedIcon}`);
    });
  });
</script>

