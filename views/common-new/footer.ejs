    <script>
      document.addEventListener("DOMContentLoaded", function () {

        const accordions = document.querySelectorAll(".accordion-collapse");

        accordions.forEach(function (collapse) {

          collapse.addEventListener("shown.bs.collapse", function () {

            let container = collapse.parentElement;

            while (container) {
              const style = window.getComputedStyle(container);

              if (
                (style.overflowY === "auto" || style.overflowY === "scroll") &&
                container.scrollHeight > container.clientHeight
              ) {
                break;
              }

              container = container.parentElement;
            }

            if (container) {
              collapse.scrollIntoView({
                behavior: "smooth",
                block: "nearest"
              });
            } else {
              collapse.scrollIntoView({
                behavior: "smooth",
                block: "start"
              });
            }

          });

        });

      });
    </script>

    <script>
      let hoverTimeout;

      function scheduleOpen(id) {
        clearTimeout(hoverTimeout);

        hoverTimeout = setTimeout(() => {

          const collapse = document.getElementById(id);


          document.querySelectorAll(".accordion-collapse.show").forEach(item => {
            if (item !== collapse) {
              bootstrap.Collapse.getOrCreateInstance(item).hide();
            }
          });

          // Open current
          bootstrap.Collapse.getOrCreateInstance(collapse).show();

          collapse.addEventListener("shown.bs.collapse", function handler() {

            const container = document.querySelector(".nwe-toke-sec-3-2");
            const item = collapse.closest(".accordion-item");

            // Scroll so the full answer becomes visible
            const scrollPos =
              item.offsetTop +
              item.offsetHeight -
              container.clientHeight +
              20;

            container.scrollTo({
              top: scrollPos,
              behavior: "smooth"
            });

            collapse.removeEventListener("shown.bs.collapse", handler);

          }, { once: true });

        }, 200);
      }

      function cancelOpen() {
        clearTimeout(hoverTimeout);
      }
    </script>
    <script>
      function equalHeightCards() {
        const cards = document.querySelectorAll(
          ".revenue-streams-section .revenue-slider .revenue-card"
        );

        let maxHeight = 0;

        // Reset height
        cards.forEach(card => {
          card.style.height = "auto";
        });

        // Find tallest card
        cards.forEach(card => {
          if (card.offsetHeight > maxHeight) {
            maxHeight = card.offsetHeight;
          }
        });

        // Apply tallest height to all cards
        cards.forEach(card => {
          card.style.height = maxHeight + "px";
        });
      }

      window.addEventListener("load", equalHeightCards);
      window.addEventListener("resize", equalHeightCards);
    </script>

<script>
  function openMenu(event, targetId) {
    var target = targetId.trim();
    var hoveredBtn = event.currentTarget;

    var targetSection = document.getElementById(target);

    if (!targetSection) {
      console.warn(
        'openMenu: no element found with id="' + target + '"'
      );
      return;
    }

    // -----------------------------------------
    // 1. Remove active from previous main menu
    // -----------------------------------------
    var btnGroup =
      hoveredBtn.closest('ul') || hoveredBtn.parentElement;

    if (btnGroup) {
      btnGroup
        .querySelectorAll('.side-btn.active')
        .forEach(function (btn) {
          btn.classList.remove('active');
        });
    }

    // -----------------------------------------
    // 2. Remove active from main content sections
    // -----------------------------------------
    var sectionParent = targetSection.parentElement;

    if (sectionParent) {
      Array.prototype.forEach.call(
        sectionParent.children,
        function (sibling) {
          if (
            sibling.classList &&
            sibling.classList.contains('content-section')
          ) {
            sibling.classList.remove('active');
          }
        }
      );
    }

    // -----------------------------------------
    // 3. Activate current main button
    // -----------------------------------------
    hoveredBtn.classList.add('active');

    // -----------------------------------------
    // 4. Show current main menu
    // -----------------------------------------
    targetSection.classList.add('active');

    // -----------------------------------------
    // 5. RESET THIS MENU'S SUBMENU
    // -----------------------------------------
    resetSubMenu(targetSection);
  }


  function openSubMenu(event, targetId) {
    var target = targetId.trim();
    var hoveredBtn = event.currentTarget;

    var targetSection = document.getElementById(target);

    if (!targetSection) {
      console.warn(
        'openSubMenu: no element found with id="' + target + '"'
      );
      return;
    }

    // -----------------------------------------
    // Remove active from previous sub-button
    // -----------------------------------------
    var btnGroup = hoveredBtn.closest('ul');

    if (btnGroup) {
      btnGroup
        .querySelectorAll('.side-btn.active')
        .forEach(function (btn) {
          btn.classList.remove('active');
        });

      // Add active to current sub-button
      hoveredBtn.classList.add('active');
    }

    // -----------------------------------------
    // Hide previous sub-content
    // -----------------------------------------
    var sectionParent = targetSection.parentElement;

    if (sectionParent) {
      sectionParent
        .querySelectorAll(':scope > .sub-content-section')
        .forEach(function (section) {
          section.classList.remove('active');
        });
    }

    // -----------------------------------------
    // Show current sub-content
    // -----------------------------------------
    targetSection.classList.add('active');
  }


  // -----------------------------------------
  // Reset submenu to first button/content
  // -----------------------------------------
  function resetSubMenu(menu) {

    if (!menu) return;

    // Find submenu buttons
    var buttons = menu.querySelectorAll('.side-btn');

    if (buttons.length) {
      buttons.forEach(function (btn) {
        btn.classList.remove('active');
      });

      // First submenu button active
      buttons[0].classList.add('active');
    }

    // Find submenu contents
    var sections = menu.querySelectorAll('.sub-content-section');

    if (sections.length) {
      sections.forEach(function (section) {
        section.classList.remove('active');
      });

      // First submenu content active
      sections[0].classList.add('active');
    }
  }
</script>
    </body>
    </html>