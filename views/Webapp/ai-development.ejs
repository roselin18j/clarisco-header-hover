                                                                if (!target) return;

                                                                const offset = 100; // 100px from top

                                                                const top =
                                                                    target.getBoundingClientRect().top +
                                                                    window.pageYOffset -
                                                                    offset;

                                                                window.scrollTo({
                                                                    top: top,
                                                                    behavior: "smooth"
                                                                });

                                                            });

                                                        });

                                                    });
