                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/backend/Python.webp", title: "Python" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/backend/Rust.webp", title: "Rust" },
                        ],
                        "pills-t-3": [
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/blockchain/eth.webp", title: "Ethereum" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/blockchain/polygon.webp", title: "Polygon" },
                        ],
                        "pills-t-4": [
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/AIframe/TensorFlow.webp", title: "TensorFlow" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/AIframe/PyTorch.webp", title: "PyTorch" },
                        ],
                        "pills-t-5": [
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/cloud/AWS.webp", title: "AWS" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/cloud/Azure.webp", title: "Azure" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/cloud/google.webp", title: "Google Cloud" },
                        ],
                        "pills-t-6": [
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/security/ssl.webp", title: "SSL/TLS" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/security/AES-256.webp", title: "AES-256" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/security/OAuth.webp", title: "OAuth 2.0" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/security/JWT.webp", title: "JWT Authentication" },
                        ]
                    };

                    function renderCards(tabId) {
                        const container = document.getElementById(`cards-${tabId}`);
                        if (!container || !tabCardsData[tabId]) return;

                        container.innerHTML = ""; // Clear previous cards

                        tabCardsData[tabId].forEach(card => {
                            const col = document.createElement("div");
                            col.className = "col";

                            col.innerHTML = `
        <div class="card">
          <div class="card-body">
            <div class="text-center mb-3">
                <img src="${card.img}" alt="${card.title}" loading="lazy" 
                  style="${['Express JS', 'iOS', 'App.JS', 'HyperLedger', 'Proton Native', 'Solidity', 'Truffle', 'Remix'].includes(card.title)
                                    ? 'filter:invert(1);'
                                    : ''}">
                        </div>
            <p class="text-center">${card.title}</p>
          </div>
        </div>
      `;

                            container.appendChild(col);
                        });
                    }

                    // Initial load for active tab
                    renderCards("pills-t-1");

                    // Attach event listeners to render cards on tab change
                    document.querySelectorAll('[data-bs-toggle="pill"]').forEach(button => {
                        button.addEventListener("shown.bs.tab", (e) => {
                            const targetId = e.target.getAttribute("data-bs-target").replace("#", "");
                            renderCards(targetId);
                        });
                    });
                </script>

                <script>
                    $(document).ready(function ($) {
                        //Check if an element was in a screen
                        function isScrolledIntoView(elem) {
                            var docViewTop = $(window).scrollTop();
                            var docViewBottom = docViewTop + $(window).height();
                            var elemTop = $(elem).offset().top;
                            var elemBottom = elemTop + $(elem).height();
                            return ((elemBottom <= docViewBottom));
                        }
                        //Count up code
                        function countUp() {
                            $('.counter').each(function () {
                                var $this = $(this), // <- Don't touch this variable. It's pure magic.
                                    countTo = $this.attr('data-count');
                                ended = $this.attr('ended');

                                if (ended != "true" && isScrolledIntoView($this)) {
                                    $({ countNum: $this.text() }).animate({
                                        countNum: countTo
                                    },
                                        {
                                            duration: 2500, //duration of counting
                                            easing: 'swing',
                                            step: function () {
                                                $this.text(Math.floor(this.countNum));
                                            },
                                            complete: function () {
                                                $this.text(this.countNum);
                                            }
                                        });
                                    $this.attr('ended', 'true');
                                }
                            });
                        }
                        //Start animation on page-load
                        if (isScrolledIntoView(".counter")) {
                            countUp();
                        }
                        //Start animation on screen
                        $(document).scroll(function () {
                            if (isScrolledIntoView(".counter")) {
                                countUp();
                            }
                        });
                    });
                </script>

