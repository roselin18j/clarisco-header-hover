                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/AIframe/PyTorch.webp", title: "PyTorch" },
                        ],
                        "pills-t-5": [
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/cloud/AWS.webp", title: "AWS" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/cloud/Azure.webp", title: "Azure" },
                            { img: "https://assets.clarisco.com/clarisco-images/ai-pages/PolymarketClone/technology/cloud/google.webp", title: "Google Cloud" },
