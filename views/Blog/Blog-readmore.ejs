            } else if (selectedValue === 'Skype') {
                placeholderText = 'Enter Skype Username ';
            } else if (selectedValue === 'Others') {
                placeholderText = 'Enter Other Contact Info';
            }
  
            $('#meta_itemcondition').attr('placeholder', placeholderText);
        });
    });
