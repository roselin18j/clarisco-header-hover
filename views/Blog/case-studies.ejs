          const swiper = new Swiper('.swiper-container', {
            direction: 'vertical',
            pagination: {
              el: '.swiper-pagination',
              clickable: true,
            },
            spaceBetween: 30,
            breakpoints: {

              320: {
                direction: 'horizontal',
                spaceBetween: 20,
                slidesPerView: 1
              },

              480: {
                direction: 'horizontal',
                spaceBetween: 20,
                slidesPerView: 1
              },

              640: {
                direction: 'vertical',
                spaceBetween: 30,
                slidesPerView: 1
              }
            }
          });
        });
      </script>

      <%- include('../common-new/footer') %>



  </body>

