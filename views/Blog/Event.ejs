                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        var swiper = new Swiper(".leftSwipertopleft", {
                            slidesPerView: 1,
                            spaceBetween: 10,
                            centeredSlides: true,
                            loop: true,
                            grabCursor: true,
                            autoplay: {
                                delay: 4000,
                                disableOnInteraction: false,
                            },
                        });

                        swiper.on('click', function () {
                            swiper.autoplay.stop();

                            setTimeout(function () {
                                swiper.autoplay.start();
                            }, 4000);
                        });
                    });
                </script>
