        <script>

          let limit = 9;
          let currentPage = 1;
          let totalPages = 1;

          const container = document.getElementById("blogssections");


          /* PAGE CACHE */
          const pageCache = {};

          async function loadBlogs(page = 1) {

            /* If page cached -> instant render */
            if (pageCache[page]) {

              renderBlogs(pageCache[page].blogs);
              totalPages = pageCache[page].totalPages;
              currentPage = page;

              renderPagination();
              updateNavButtons();
              prefetchPage(page + 1);

              return;
            }

            let offset = (page - 1) * limit;

            let res = await fetch(`/blog-pagination?limit=${limit}&offset=${offset}`);
            let data = await res.json();

            totalPages = Math.ceil(data.count / limit);

            /* Hide pagination if only 1 page */

            if (totalPages >= 2) {
              document.getElementById("pagination").style.display = "flex";
            }

            /* Save cache */

            pageCache[page] = {
              blogs: data.blogsdata,
              totalPages: totalPages
            };

            renderBlogs(data.blogsdata);

            currentPage = page;

            renderPagination();
            updateNavButtons();

            /* Prefetch next page */

            prefetchPage(page + 1);

          }

          function renderBlogs(blogs) {

            let html = "";

            blogs.forEach(item => {

              html += `
<div class="loader-blog">
<div class="col h-100">

<a href="https://www.clarisco.com/${item.blog_link}" target="_blank">

<div class="card blog-card-style-2 h-100">

<div class="top-blog-image-variable">
<img loading="lazy" src="${item.blogimg ? item.blogimg : '/assets/blogs.jpg'}" class="card-img-top" onerror="this.onerror=null;this.src='/assets/blogs.jpg';" alt="blogs"/>
</div>

<div class="card-body pb-auto px-0">

<div class="d-flex flex-row justify-content-between">

<div>
<p class="post-item__meta post-item__meta--category">
${item.blog_category}
</p>
</div>

<div>
<time class="post-item__meta post-item__meta--date">
${item.date}
</time>
</div>

</div>

<div class="row">
<div class="col">
<h3 class="card-title blog-page-title mt-2">
${item.blog_title}
</h3>
</div>
</div>

<div class="row blog-para-list-limit getting">
<div class="col">
<p class="card-text blog-para-list">
${item.blog_meta_description}
</p>
</div>
</div>
<div class="blog-btm-row">
                                                         <span class="read-more-cta" aria-hidden="true">
                                                            Read More <i class="bi bi-arrow-right"></i>
                                                        </span>
                                                        <div class="ryt">
<p>Author</p>
<span>Priyadharshini Suriyanarayanan</span>
</div>
                                                       </div>

</div>
</div>

</a>

</div>
</div>
`;

            });

            container.innerHTML = html;

          }

          /* PREFETCH NEXT PAGE */

          async function prefetchPage(page) {

            if (page > totalPages) return;
            if (pageCache[page]) return;

            let offset = (page - 1) * limit;

            fetch(`/blog-pagination?limit=${limit}&offset=${offset}`)
              .then(res => res.json())
              .then(data => {

                pageCache[page] = {
                  blogs: data.blogsdata,
                  totalPages: Math.ceil(data.count / limit)
                };

              });

          }

          /* PAGINATION UI */

          function renderPagination() {

            let html = "";

            let start = Math.max(1, currentPage - 2);
            let end = Math.min(totalPages, currentPage + 2);

            /* FIRST PAGE */

            if (start > 1) {

              html += `<a href="javascript:void(0)" onclick="loadBlogs(1)">1</a>`;

              if (start > 2) {
                html += `<span class="dots">...</span>`;
              }

            }

            /* PAGE LOOP */

            for (let i = start; i <= end; i++) {

              html += `<a href="javascript:void(0)" class="${i === currentPage ? 'active' : ''}" onclick="loadBlogs(${i})">${i}</a>`;

            }

            /* LAST PAGE */

            if (end < totalPages) {

              if (end < totalPages - 1) {
                html += `<span class="dots">...</span>`;
              }

              html += `<a href="javascript:void(0)" onclick="loadBlogs(${totalPages})">${totalPages}</a>`;

            }

            document.getElementById("pageNumbers").innerHTML = html;

          }

          /* ENABLE / DISABLE BUTTONS */

          function updateNavButtons() {

            const prevBtn = document.getElementById("prevBtn");
            const nextBtn = document.getElementById("nextBtn");

            /* PREV */

            if (currentPage === 1) {

              prevBtn.disabled = true;
              prevBtn.style.opacity = "0.5";
              prevBtn.style.cursor = "not-allowed";

            } else {

              prevBtn.disabled = false;
              prevBtn.style.opacity = "1";
              prevBtn.style.cursor = "pointer";

            }

            /* NEXT */

            if (currentPage === totalPages) {

              nextBtn.disabled = true;
              nextBtn.style.opacity = "0.5";
              nextBtn.style.cursor = "not-allowed";

            } else {

              nextBtn.disabled = false;
              nextBtn.style.opacity = "1";
              nextBtn.style.cursor = "pointer";

            }

          }

          /* NAVIGATION */

          document.getElementById("nextBtn").onclick = () => {

            if (currentPage < totalPages) {
              loadBlogs(currentPage + 1);
            }

          }

          document.getElementById("prevBtn").onclick = () => {

            if (currentPage > 1) {
              loadBlogs(currentPage - 1);
            }

          }

          /* INITIAL LOAD */

          loadBlogs();

        </script>




        <script>
          $(document).ready(function () {
            $(window).scroll(function () {
              var wscroll = $(this).scrollTop();
              if (wscroll > 50) {
                $(".top-newbar-section .navbar").css("background-color", "rgb(249 251 255)");
              }
              else {
                $(".top-newbar-section .navbar").css("background-color", "transparent");
              }
            });
          });
        </script>

  </body>

  </html>