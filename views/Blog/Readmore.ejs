       <script>
        document.addEventListener("DOMContentLoaded", function () {
    let shown = false;

    window.addEventListener("scroll", function () {
        if (shown) return;

        if (window.scrollY >= window.innerHeight * 2.5) {
            shown = true;
            document.getElementById("scrollPopup").style.display = "block";
        }
    });
});
       </script>

   <script>
    document.addEventListener("DOMContentLoaded", () => {

    const modalElement = document.getElementById("PopForm");

    if (!modalElement) {
        console.error("PopForm not found");
        return;
    }

    let popupShown = false;

    window.addEventListener("scroll", () => {

        if (popupShown) return;

        if (window.scrollY >= window.innerHeight * 2.5) {

            popupShown = true;

            const popup = bootstrap.Modal.getOrCreateInstance(modalElement);
            popup.show();

        }

    });

});
   </script>
      <script>
        function scrollToSection(targetId) {
          const element = document.getElementById(targetId);
console.log(element,"element");

          if (element) {
            const elementTop = element.getBoundingClientRect().top + window.pageYOffset;
            const offset = window.innerHeight * 0.2;

            window.scrollTo({
              top: elementTop - offset,
              behavior: "smooth"
            });
          }
        }

        // Desktop click
        document.querySelectorAll(".toc-link").forEach(link => {
          link.addEventListener("click", function () {

            document.querySelectorAll(".toc-link").forEach(el => {
              el.classList.remove("active");
            });

            this.classList.add("active");
           console.log(this.dataset.target);
           
            scrollToSection(this.dataset.target);
          });
        });

        // Mobile select change
        const select = document.querySelector(".toc-select");
        if (select) {
          select.addEventListener("change", function () {            
            if (this.value) {
              scrollToSection(this.value);
            }
          });
        }
      </script>

      <script>
        $(document).ready(function () {

          const blogId = " <%- blogdata.id %> ";

          $.ajax({
            method: "GET",
            url: `https://www.clarisco.com/adjacentBlogs/${blogId}`,
            encode: true,
          }).done(function (response) {
            console.log(response)
            if (!response.prev) {
              $("#prevBtn").prop("disabled", true).css("opacity", "0.5");
            }

            if (!response.next) {
              $("#nextBtn").prop("disabled", true).css("opacity", "0.5");
            }

          });

          $(window).scroll(function () {
            var wscroll = $(this).scrollTop();
            if (wscroll > 50) {
              $(".top-newbar-section .navbar").css("background-color", "rgb(249 251 255)");
            }
            else {
              $(".top-newbar-section .navbar").css("background-color", "transparent");
            }
          });
        });
      </script>

      <script>
        function nextBlog(id) {
          $.ajax({
            method: "GET",
            url: `https://www.clarisco.com/nextBlog/${id}`,
            encode: true,
          }).done(function (response) {
            var link = response.blog_link
            window.location.href = `https://www.clarisco.com/${link}`

          });
        }
      </script>

      <script>
        function prevBlog(id) {
          $.ajax({
            method: "GET",
            url: `https://www.clarisco.com/prevBlog/${id}`,
            encode: true,
          }).done(function (response) {
            var link = response.blog_link
            window.location.href = `https://www.clarisco.com/${link}`

          });
        }
      </script>

