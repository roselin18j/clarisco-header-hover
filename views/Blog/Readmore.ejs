                  .replace(/&nsbp;/gi, ' ' ) .replace(/&nbsp;/gi, ' ' );
                  blogdata.blog_table_of_contents.forEach(function(title) { const cleanTitle=title
                  .replace(/&nbsp;/gi, ' ' ) .replace(/&nsbp;/gi, ' ' ) .trim(); const id=generateId(cleanTitle); const
                  safeTitle=cleanTitle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&' ); 
                  const regex = new RegExp(`<strong[^>]*>\\s*${safeTitle}\\s*<\\/strong>`,"gi");

                    content = content.replace(
                    regex,
                    `<strong id="${id}">${cleanTitle}</strong>`
                    );

                    });

                    content = content.replace(/<p[^>]>\s<\/p>/gi, '&nbsp;');
                        %>

