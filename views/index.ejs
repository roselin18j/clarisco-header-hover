                  function renderCards(tabId) {
                    const container = document.getElementById(`cards-${tabId}`);
                    if (!container || !tabCardsData[tabId]) return;

                    container.innerHTML = ""; // Clear previous cards

                    tabCardsData[tabId].forEach(card => {
                      const col = document.createElement("div");
                      col.className = "col";

                      col.innerHTML = `
        <div class="card">
          <div class="card-body">
            <div class="text-center mb-3">
                <img loading="lazy" rel="preload" src="${card.img}" alt="${card.title}" 
                  style="${['Express JS', 'iOS', 'App.JS', 'HyperLedger', 'Proton Native', 'Solidity', 'Truffle', 'Remix'].includes(card.title)
                          ? 'filter:invert(1);'
                          : ''}">
                        </div>
            <p class="text-center">${card.title}</p>
          </div>
        </div>
      `;

                      container.appendChild(col);
                    });
                  }

                  // Initial load for active tab
                  renderCards("pills-t-1");

                  // Attach event listeners to render cards on tab change
                  document.querySelectorAll('[data-bs-toggle="pill"]').forEach(button => {
                    button.addEventListener("shown.bs.tab", (e) => {
                      const targetId = e.target.getAttribute("data-bs-target").replace("#", "");
                      renderCards(targetId);
                    });
                  });
                </script>

