            <% const cloneScripts=[ { icon: "../assets/game-img/unty-discover1.webp" ,
                title: "Custom Unity Game Development" ,
                description: "Every title Clarisco builds in Unity is engineered from the ground up to your brief with genre, platform targets, monetization model, and performance requirements. Our custom Unity game development services cover the complete production scope from GDD through submitted build."
                }, { icon: "../assets/game-img/unty-discover2.webp" , title: "2D Unity Game Development" ,
                description: "Our 2D Unity pipeline covers hand-painted, pixel art, vector, and procedural visual styles across casual, hybrid-casual, puzzle, platformer, and roguelite genres. We handle sprite production, Spine and Unity animation integration, physics-based mechanics, procedural level generation, and 2D UI systems."
                }, { icon: "../assets/game-img/unty-discover3.webp" , title: "3D Unity Game Development" ,
                description: "Our 3D Unity game development services span mobile-optimized 3D, PC and console-quality environments, and VR/AR experiences built using Unity's URP and HDRP render pipelines. We handle 3D character and environment art integration, shader development, physics, lighting, and performance profiling."
                }, { icon: "../assets/game-img/unty-discover4.webp" , title: "Full-Cycle Unity Game Development" ,
                description: "From concept and GDD through Unity engineering, QA, platform submission, and post-launch LiveOps, our full-cycle Unity game development services give founders and publishers a single studio managing every production phase."
                }, { icon: "../assets/game-img/unty-discover5.webp" , title: "Unity Co-Development & Engine Support" ,
                description: "For studios with an existing Unity project that needs additional engineering capacity, our co-development teams plug directly into your depot, milestone cadence, and code by delivering features, fixing structural issues, or accelerating a specific system without disrupting the work your internal team is already running."
                }, { icon: "../assets/game-img/unty-discover6.webp" , title: "Unity Mobile Optimization" ,
                description: "Our Unity mobile optimization practice profiles iOS and Android builds against thermal throttling limits, memory budgets, GPU constraints, and battery draw, tuning the render pipeline, texture compression, draw call count, and asset streaming to maintain stable performance across the full range of target devices."
                }, { icon: "../assets/game-img/unty-discover7.webp" , title: "Unity Multiplayer & Backend Integration" ,
                description: "Real-time multiplayer implementation using Unity Netcode, Mirror, and Photon covering state replication, lag compensation, matchmaking, and dedicated server setup. Backend integration with PlayFab, GameSparks, and custom Node.js services for player accounts, cloud saves, leaderboards, and live-service telemetry."
                }, { icon: "../assets/game-img/unty-discover8.webp" , title: "Unity LiveOps & Post-Launch Support" ,
                description: "Post-launch event scheduling, economy rebalancing, seasonal content integration, new OS version compatibility patches, and ongoing feature development managed by the same Unity team that built the title, without a re-onboarding process for each content release."
