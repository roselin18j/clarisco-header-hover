            <% const cloneScripts=[ { icon: "../assets/game-img/fulcy-discover1.webp" , title: "Functional QA Testing" ,
                description: "Our functional QA testing games practice validates every gameplay feature, system interaction, UI flow, and edge case against your game design document and feature specification by producing defect reports with full reproduction steps, expected versus actual results, and severity classification for every finding."
                }, { icon: "../assets/game-img/fulcy-discover2.webp" , title: "Regression Testing" ,
                description: "Every code integration, feature addition, and bug fix is validated through structured regression testing to confirm previously approved functionality remains intact. Our regression testing games practice maintains a living test suite updated with each sprint's new features and fix verifications by catching regressions."
                }, { icon: "../assets/game-img/fulcy-discover3.webp" ,
                title: "Platform Compliance & Certification Testing" ,
                description: "Our console game testing services cover systematic compliance testing against PlayStation TRC, Xbox TCR, and Nintendo Switch LotCheck requirements by identifying certification failures before the submission build is prepared. For mobile, we test against Apple App Store Review Guidelines and Google Play policy requirements."
                }, { icon: "../assets/game-img/fulcy-discover4.webp" , title: "Mobile Game QA Testing" ,
                description: "Specialized mobile game QA testing across iOS and Android by covering device compatibility testing, OS version compatibility, touch input validation, in-app purchase flow testing, ad SDK behaviour, crash reproduction, push notification testing, and App Store and Google Play pre-submission compliance checks."
                }, { icon: "../assets/game-img/fulcy-discover5.webp" , title: "Localization QA Testing" ,
                description: "Our localization QA testing practice covers text truncation, font rendering, character encoding, cultural appropriateness, audio sync for dubbed dialogue, subtitle timing accuracy, and UI layout integrity across every target language build that is tested against your localization kit before any regional store submission."
                }, { icon: "../assets/game-img/fulcy-discover6.webp" , title: "Multiplayer & Network Testing" ,
                description: "Dedicated multiplayer game testing covering matchmaking flow, session creation and joining, state synchronization under latency conditions, disconnection and reconnection handling, server stability under concurrent player load, anti-cheat validation, and cross-platform play parity testing."
                }, { icon: "../assets/game-img/fulcy-discover7.webp" , title: "Performance & Load Testing" ,
                description: "Game performance testing across target hardware tiers with CPU and GPU usage profiling, memory allocation tracking, loading time measurement, and thermal monitoring under sustained play sessions. Automated load testing for multiplayer backend by covering server capacity at target concurrent player counts."
                }, { icon: "../assets/game-img/fulcy-discover8.webp" , title: "Automated Game Testing Services" ,
                description: "Custom automated test suite development for regression coverage with scripted test agents that play through defined game flows overnight against daily builds, reporting crashes, logic failures, and frame rate regressions before the development team arrives in the morning."
                } ]; %>

