                                                            <script>
                                                                document.addEventListener("DOMContentLoaded", function () {

                                                                    // TOP TABS
                                                                    const navSwiper = new Swiper(".portfolio-nav", {
                                                                        slidesPerView: "auto",
                                                                        spaceBetween: 20,
                                                                        freeMode: true,
                                                                        watchSlidesProgress: true,
                                                                        slideToClickedSlide: true,
                                                                    });

                                                                    // MAIN SLIDER
                                                                    const portfolioSwiper = new Swiper(".portfolio-swiper", {
                                                                        loop: false,
                                                                        centeredSlides: true,
                                                                        loopAdditionalSlides: 10,

                                                                        slidesPerView: "auto",
                                                                        centeredSlides: true,

                                                                        speed: 500,

                                                                        effect: "coverflow",

                                                                        preventInteractionOnTransition: true,

                                                                        coverflowEffect: {
                                                                            rotate: -40,
                                                                            depth: 700,
                                                                            modifier: .4,
                                                                            scale: 1,
                                                                            slideShadows: false,
                                                                        },

                                                                        autoplay: {
                                                                            delay: 2000,
                                                                            disableOnInteraction: false,
                                                                        },

                                                                        thumbs: {
                                                                            swiper: navSwiper,
                                                                        },

                                                                        breakpoints: {
                                                                            0: {
                                                                                slidesPerView: 1.5,
                                                                                spaceBetween: 20,
                                                                            },
                                                                            500: {
                                                                                slidesPerView: 2,
                                                                                spaceBetween: 20,
                                                                            },
                                                                            768: {
                                                                                slidesPerView: 3,
                                                                                spaceBetween: 50,
                                                                            },
                                                                            1200: {
                                                                                slidesPerView: 3,
                                                                                spaceBetween: 100,
                                                                            }
                                                                        }
                                                                    });

                                                                    // CUSTOM NAVIGATION
                                                                    document.querySelector(".portfolio-next").addEventListener("click", function (e) {
                                                                        e.preventDefault();

                                                                        if (!portfolioSwiper.animating) {
                                                                            portfolioSwiper.slideNext();
                                                                        }
                                                                    });

                                                                    document.querySelector(".portfolio-prev").addEventListener("click", function (e) {
                                                                        e.preventDefault();

                                                                        if (!portfolioSwiper.animating) {
                                                                            portfolioSwiper.slidePrev();
                                                                        }
                                                                    });

                                                                    // Pause autoplay
                                                                    const container = document.querySelector(".portfolio-swiper");

                                                                    container.addEventListener("mouseenter", () => {
                                                                        portfolioSwiper.autoplay.stop();
                                                                    });

                                                                    container.addEventListener("mouseleave", () => {
                                                                        portfolioSwiper.autoplay.start();
                                                                    });

                                                                    // Active Tab
                                                                    portfolioSwiper.on("slideChange", function () {

                                                                        document.querySelectorAll(".portfolio-nav .swiper-slide")
                                                                            .forEach(slide => slide.classList.remove("active"));

                                                                        const activeSlide = document.querySelectorAll(".portfolio-nav .swiper-slide")[portfolioSwiper.realIndex];

                                                                        if (activeSlide) {
                                                                            activeSlide.classList.add("active");
                                                                            navSwiper.slideTo(portfolioSwiper.realIndex);
                                                                        }

                                                                    });

                                                                });
                                                            </script>
                                                            <script>
                                                                document.addEventListener("DOMContentLoaded", function () {

                                                                    const floatingNav = document.querySelector(".floating-nav");
                                                                    if (!floatingNav) return;

                                                                    let hideTimer;

                                                                    function pastHero() {
                                                                        return window.scrollY >= window.innerHeight;
                                                                    }

                                                                    function showNav() {
                                                                        if (!pastHero()) return;

                                                                        floatingNav.classList.add("show");

                                                                        clearTimeout(hideTimer);

                                                                        // Hide after 2 seconds of no interaction
                                                                        hideTimer = setTimeout(() => {
                                                                            floatingNav.classList.remove("show");
                                                                        }, 2000);
                                                                    }

                                                                    function hideNav() {
                                                                        floatingNav.classList.remove("show");
                                                                        clearTimeout(hideTimer);
                                                                    }

                                                                    // Initial state
                                                                    if (pastHero()) {
                                                                        showNav();
                                                                    } else {
                                                                        hideNav();
                                                                    }

                                                                    // Handle scroll position
                                                                    window.addEventListener("scroll", function () {
                                                                        if (pastHero()) {
                                                                            showNav();
                                                                        } else {
                                                                            hideNav();
                                                                        }
                                                                    });

                                                                    // Show again on any user interaction
                                                                    ["mousemove", "click", "keydown", "touchstart", "wheel"].forEach(event => {
                                                                        document.addEventListener(event, function () {
                                                                            if (pastHero()) {
                                                                                showNav();
                                                                            }
                                                                        });
                                                                    });

                                                                });
                                                            </script>
                                                            <script>
                                                                document.addEventListener("DOMContentLoaded", () => {

                                                                    document.querySelectorAll(".float-link").forEach(link => {

                                                                        link.addEventListener("click", function (e) {
                                                                            e.preventDefault();

                                                                            const target = document.getElementById(this.dataset.target);

                                                                            if (!target) return;

                                                                            const offset = 100; // 100px from top

                                                                            const top =
                                                                                target.getBoundingClientRect().top +
                                                                                window.pageYOffset -
                                                                                offset;

                                                                            window.scrollTo({
                                                                                top: top,
                                                                                behavior: "smooth"
                                                                            });

                                                                        });

                                                                    });

                                                                });
                                                            </script>

