                            <h2 class="nwe-toke-txt-4 mb-3 text-center" data-aos="fade-up">
                                What Are Game Porting & Cross-Platform Development Services?
                            </h2>
                            <p class="nw-w-txt-2 text-center mb-3" data-aos="fade-up" style="color: #0000008f;">
                                Game porting is the process of adapting an existing game title from its original
                                platform to one or more new target platforms by reworking the engine configuration,
                                platform SDK integration, control scheme, performance profile, and user interface to
                                meet the technical requirements and player expectations of the destination platform.
                            </p>
                            <p class="nw-w-txt-2 text-center mb-3" data-aos="fade-up" style="color: #0000008f;">
                                Cross-platform game development is the practice of building a title from the ground up
                                to run on multiple platforms simultaneously by using a shared codebase,
                                platform-agnostic game logic, and platform-specific build configurations that allow a
                                single production pipeline to target iOS, Android, PC, and console without maintaining
                                fully separate codebases per platform. As a specialist game porting studio, Clarisco
                                handles both scenarios.
                            </p>

                            <div class="d-flex justify-content-center gap-2" data-aos="fade-up">
                                <a href="https://api.whatsapp.com/send?phone=919442430551&text=*Hi%20there!%20I%20am%20looking%20for%20your%20Services,%20Shall%20we%20Start%20the%20discussion*"
                                    target="_blank">
                                    <button class="nw-w-btn-1 w-gre-btn-1"><i class="fa-brands fa-whatsapp"></i> <span
                                            style="font-size: 14px;">Whatsapp</span></button>
                                </a>
                                <a href="https://telegram.me/ClariscoSolutions" target="_blank">
                                    <button class="nw-w-btn-1 w-gre-blue-1"><i class="fa-brands fa-telegram"></i> <span
                                            style="font-size: 14px;">Telegram</span></button>
                                </a>
                            </div>
                            <div data-aos="fade-up" class="mt-5 col-md-7 mx-auto p-2"
                                style="background: #3B387B26;border-radius: 30px;">
                                <img src="../assets/game-img/fulcy-banner2.webp" alt="carbon" class="img-fluid" />
                            </div>
                        </div>
                    </div>
            </section>

            <% const cloneScripts=[ { icon: "../assets/game-img/fulcy-discover1.webp" , title: "PC to Console Porting" ,
                description: "Clarisco ports PC titles to PlayStation 5 and Xbox Series X|S by managing PS5 SDK and Xbox GDK integration, DualSense haptics, Xbox Smart Delivery asset tiering, UI adaptation for TV viewing distance, controller UX redesign, console performance optimization, and end-to-end TRC/TCR certification submission management through to platform holder approval."
                }, { icon: "../assets/game-img/fulcy-discover2.webp" , title: "Nintendo Switch Porting" ,
                description: "Our Nintendo Switch porting practice carries PC and console titles to both handheld and docked Switch targets by covering performance optimization to stable 30fps handheld and 60fps docked profiles, resolution scaling implementation, shader compilation reduction, memory footprint optimization, Nintendo SDK integration, and full LotCheck certification."
                }, { icon: "../assets/game-img/fulcy-discover3.webp" , title: "PC to Mobile Game Porting" ,
                description: "We port PC and console titles to iOS and Android by handling touch control redesign, UI scaling for mobile screen sizes, mobile GPU and memory profiling, texture compression conversion, draw call reduction, battery and thermal optimization, and App Store and Google Play submission, including metadata, age rating, and binary compliance management."
                }, { icon: "../assets/game-img/fulcy-discover4.webp" , title: "Mobile to PC & Console Porting" ,
                description: "Successful mobile titles expanded to PC or console use Clarisco's reverse porting practice by covering resolution and aspect ratio adaptation, keyboard and mouse scheme design, PC performance scaling across hardware tiers, Steam SDK integration, and console platform certification where the title targets PS5, Xbox, or Nintendo Switch alongside Steam."
                }, { icon: "../assets/game-img/fulcy-discover5.webp" , title: "Cross-Platform Game Development" ,
                description: "For titles being built to launch on multiple platforms, our cross-platform game development practice establishes platform-agnostic development from the first sprint with shared game logic, platform-specific build configuration, conditional UI scaling, input abstraction layers, and platform-native feature hooks that allow a single codebase to target mobile, PC, and console."
                }, { icon: "../assets/game-img/fulcy-discover6.webp" ,
                title: "Unity Cross-Platform Porting & Optimization" ,
                description: "Specialist Unity cross-platform development and porting by covering Unity build pipeline configuration per platform, Unity mobile optimization for iOS and Android, Addressables setup for platform-specific asset variants, quality settings tiering, and platform-specific submission management for all Unity-supported targets including consoles and WebGL."
                }, { icon: "../assets/game-img/fulcy-discover7.webp" , title: "Unreal Engine Cross-Platform Porting" ,
                description: "UE5 cross-platform porting covering Scalability Group configuration, platform-specific rendering feature overrides, Nanite fallback mesh setup for platforms without Nanite support, console SDK integration, and UE5 performance profiling using Unreal Insights, adapted per target platform's hardware constraints and first-party technical requirements."
                }, { icon: "../assets/game-img/fulcy-discover7.webp" , title: "Cross-Platform Multiplayer Integration" ,
                description: "Cross-platform multiplayer architecture using Epic Online Services, Steam, and platform-native online subsystems by enabling cross-play between PC, console, and mobile players with shared leaderboards, matchmaking, and cloud save built to each platform's online compliance requirements."
