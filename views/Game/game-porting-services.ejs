                                                                function renderCards(tabId) {
                                                                    const container = document.getElementById(`cards-${tabId}`);
                                                                    if (!container || !tabCardsData[tabId]) return;

                                                                    container.innerHTML = ""; // Clear previous cards

                                                                    tabCardsData[tabId].forEach(card => {
                                                                        const col = document.createElement("div");
                                                                        col.className = "col";
                                                                        col.innerHTML = ` <div class="card h-100">
                                                                            <div class="card-body">
                                                                            <img src=${card.icon} alt=${card.title} loading="lazy" width="48" height="48" />
                                                                            <h3 class="fw-bold mb-3">${card.title}</h3>
                                                                            <p class="mb-0" style="font-size: 14px;">${card.text}</p>
                                                                             </div>
                                                                            </div>
                                                                            `;
                                                                        container.appendChild(col);
                                                                    });
                                                                }

                                                                // Initial load for active tab
