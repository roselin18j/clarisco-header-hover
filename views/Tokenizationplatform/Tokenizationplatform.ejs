                                Real Struggles Asset Owners and Platform Builders Face & How We Solve This
                            </h2>
                            <div class="row justify-content-center">
                                <div class="col-lg-9 nwe-toke-sec-3-2">
                                    <div class="accordion accordion-flush custom-accordion w-100"
                                        id="accordionFlushExample" data-aos="fade-up">
                                        <% accordionData.map((item, index)=> { %>
                                            <div class="accordion-item"
                                                onmouseenter="scheduleOpen('flush-collapse-<%= index %>', this)"
                                                onmouseleave="cancelOpen()">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#flush-collapse-<%= index %>"
                                                        aria-expanded="false">
                                                        <img loading="lazy" width="72" height="72" src="https://assets.clarisco.com/assets/rwa-nw/q.png"
                                                            alt="question" class="img-fluid" style="width: 24px;" />
                                                        <%= item.title %>
                                                            <i class="fa-solid fa-arrow-right ms-auto"></i>
                                                    </button>
                                                </h2>

                                                <div id="flush-collapse-<%= index %>"
                                                    class="accordion-collapse collapse">
                                                    <div class="accordion-body d-flex align-items-center gap-3 ps-5">
                                                        <i class="fa-solid fa-circle-right fs-4"
                                                            style="color: #7b7fe6;"></i>
                                                        <span style="color: #000000a2;">
                                                            <%= item.content %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
