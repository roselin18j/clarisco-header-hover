                            <h2 class="nwe-toke-txt-4 mb-3 text-center" data-aos="fade-up">
                                What is <span class="curve-text">Carbon Credits Tokenization</span> Development?
                            </h2>
                            <p class="nw-w-txt-2 text-center mb-3" style="color: #0000008f;" data-aos="fade-up">
                                Carbon credits tokenization is the process of converting verified carbon offset credits,
                                each representing one tonne of CO₂ reduced, avoided, or sequestered, into
                                blockchain-based digital tokens. Each token inherits the full provenance, certification
                                standard, and retirement status of the underlying credit to make it instantly tradeable.
                            </p>
                            <p class="nw-w-txt-2 text-center mb-5" style="color: #0000008f;" data-aos="fade-up">
                                Clarisco Solutions builds the complete technical stack for your carbon token with
                                registry API integration (Verra, Gold Standard, ACR), ERC-20 or ERC-1155 smart
                                contracts, Toucan Protocol compatibility, on-chain credit retirement mechanisms, KYC/AML
                                investor onboarding, and secondary market liquidity.
                            </p>

                            <% const complianceList=[ "ERC-20 / ERC-1155" , "Verra / Gold Standard Aligned"
                                , "IoT-Based Emissions Tracking" , "Real-Time MRV Integration" , "KYC/AML Built-In"
                                , "Multi-Chain Compatible" , "DeFi & Carbon Markets Ready" , "Third-Party Audited" ]; %>

                                <div class="row row-cols-2 row-cols-md-4 row-cols-lg-4 g-4">
                                    <% complianceList.map((item)=> { %>
                                        <div class="col">
                                            <div class="card p-2 border-0 text-center" data-aos="fade-up"
                                                style="background-color: #c2caee2d;">
                                                <p class="mb-0 nw-w-txt-list">
                                                    <%= item %>
                                                </p>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <div data-aos="fade-up" class="mt-5 col-md-7 mx-auto">
                                    <img loading="lazy" width="2808" height="1864" src="https://assets.clarisco.com/assets/rwa-nw/carbon/banner/Banner1.webp"
                                        alt="carbon" class="img-fluid" />
                                </div>
                                <div data-aos="fade-up" class="mt-5 text-center">
                                    <button class="nw-w-btn-1" data-bs-toggle="modal" data-bs-target="#PopForm">Launch
                                        Your Carbon Token</button>
                                </div>
                        </div>
                    </div>
                </div>
            </section>

            <% const accordionData=[ {
                title: "Hiring lawyers in every country is draining my budget before I even launch" ,
                content: "We help in multi-jurisdiction legal structuring in-house across 30+ countries" }, {
                title: "Getting carbon credits verified by Verra or Gold Standard takes forever, and I lose buyers" ,
                content: "We integrate directly with registry APIs to automate verification and on-chain credit issuance"
                }, { title: "Buyers have no way to prove the credit they bought hasn't already been retired elsewhere" ,
                content: "Our on-chain retirement mechanism makes every retirement permanently visible and tamper-proof"
                }, { title: "My carbon credits are sitting idle in a registry account, earning nothing for months" ,
                content: "We tokenize your credits and list them on DeFi and voluntary market venues immediately" }, {
                title: "Building on the Toucan Protocol sounds right, but nobody on my team understands how it works" ,
                content: "Our engineers have built multiple Toucan-compatible platforms and handle every integration layer"
                }, { title: "Corporate buyers want an ESG audit trail, but I cannot generate one automatically" ,
                content: "Our platform auto-generates immutable on-chain ESG compliance reports for every credit retired"
                }, { title: "I want to sell credits to retail buyers, but the minimum trade size makes it impossible" ,
                content: "We fractionalize credit batches so individual investors can participate from under $10" }, {
                title: "Every registry operates differently, and bridging between them is a technical nightmare" ,
                content: "Our multi-registry adapter layer connects Verra, Gold Standard, ACR, and others in one platform"
                }, { title: "Nobody can tell me whether tokenized carbon credits are securities in my jurisdiction" ,
                content: "Our legal team classifies your tokens and files the right regulatory paperwork across 32+ countries"
                } ]; %>

