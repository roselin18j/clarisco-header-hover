                                        alt="realestate" class="img-fluid" />
                                </div>
                                <div class="d-flex flex-row align-items-center justify-content-center mt-5 gap-2"
                                    data-aos="fade-up">
                                    <button class="nw-w-btn-1" data-bs-toggle="modal" data-bs-target="#PopForm">
                                        Launch Your Gold Token
                                    </button>
                                </div>
                        </div>
                    </div>
                </div>
