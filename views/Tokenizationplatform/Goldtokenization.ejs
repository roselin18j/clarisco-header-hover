                            <h2 class="nwe-toke-txt-4 mb-3 text-center" data-aos="fade-up">
                                What is <span class="curve-text">Gold Tokenization</span> Development?
                            </h2>
                            <p class="nw-w-txt-2 text-center mb-3" style="color: #0000008f;" data-aos="fade-up">
                                Gold tokenization is the process of converting ownership rights in physical gold stored
                                in insured, audited vaults into blockchain-based digital tokens. Each token represents a
                                fixed quantity of real gold (1 gram or 1 troy ounce), making the world's oldest store of
                                value instantly tradeable, fractionalized, and globally accessible without the barriers
                                of physical storage, transportation, or high minimum investments.
                            </p>
                            <p class="nw-w-txt-2 text-center mb-5" style="color: #0000008f;" data-aos="fade-up">
                                Clarisco Solutions builds the complete technical stack for your digital asset
                                tokenization platform with vault custody integration, ERC-20 or ERC-1400 smart
                                contracts, Chainlink proof-of-reserve, KYC/AML compliance, and secondary market
                                liquidity. Our gold tokenization services power everything from fractional retail
                                investment apps to institutional commodity trading platforms and DeFi gold collateral
                                protocols across every major RWA tokenization platform on the market.
                            </p>

                            <% const complianceList=[ "ERC-20 / ERC-1400" , "Chainlink PoR" , "Vault Integrated"
                                , "KYC/AML Built-In" , "Multi-Chain" , "DeFi Ready" , "Dual Audited" , "LBMA Standard"
                                ]; %>

                                <div class="row row-cols-2 row-cols-md-4 row-cols-lg-4 g-4">
                                    <% complianceList.map((item)=> { %>
                                        <div class="col">
                                            <div class="card p-2 border-0 text-center" data-aos="fade-up"
                                                style="background-color: #c2caee2d;">
                                                <p class="mb-0 nw-w-txt-list">
                                                    <%= item %>
                                                </p>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <div data-aos="fade-up" class="mt-5 col-md-7 mx-auto">
