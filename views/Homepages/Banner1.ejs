<script>
    document.addEventListener("DOMContentLoaded", function () {

        const buttons = document.querySelectorAll(".pos-nw-bann-1 button");

        // ✅ MAKE GLOBAL
        window.mainSwiper = new Swiper(".mySwiperBann", {
            slidesPerView: 1,
            spaceBetween: 20,
            loop: true,
            autoplay: {
                delay: 12500,
                disableOnInteraction: false,
            },
            on: {
                init: function () {
                    setActive(this.realIndex);
                },
                slideChange: function () {
                    setActive(this.realIndex);

                    // 🔥 STOP AUDIO
                    document.querySelectorAll(".music-card audio").forEach(a => a.pause());

                    document.querySelectorAll(".play-btn").forEach(btn => {
                        btn.innerHTML = `<i class="fa-solid fa-play"></i>`;
                    });

                    // ✅ RESUME AUTOPLAY ON SWIPE
                    if (this.autoplay) {
                        this.autoplay.start();
                    }
                }
            }
        });

        buttons.forEach((btn, index) => {
            btn.addEventListener("click", () => {
                window.mainSwiper.slideToLoop
                    ? window.mainSwiper.slideToLoop(index)
                    : window.mainSwiper.slideTo(index);

                setActive(index);
            });
        });

        function setActive(activeIndex) {
            buttons.forEach((btn, i) => {
                btn.classList.toggle("active", i === activeIndex);
            });
        }

        /* =========================
           ONLY ADD THIS PART
        ========================= */
        document.querySelectorAll(".music-card .play-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                // ✅ STOP AUTOPLAY WHEN USER PLAYS AUDIO
                if (window.mainSwiper?.autoplay) {
                    window.mainSwiper.autoplay.stop();
                }
            });
        });

    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const totalInnerSwipers = 5; // change if more slides

        for (let i = 1; i <= totalInnerSwipers; i++) {

            const swiperClass = `.mySwiperBann2_${i}`;
            const paginationClass = `.swiper-page2_${i}`;

            // skip if swiper not present (important for dynamic slides)
            if (!document.querySelector(swiperClass)) continue;

            new Swiper(swiperClass, {
                observer: false,
                observeParents: false,
                slidesPerView: 1,
                spaceBetween: 20,
                loop: true,

                autoplay: {
                    delay: 4000,
                    disableOnInteraction: false,
                },

                pagination: {
                    el: paginationClass,
                    clickable: true,
                },

                on: {
                    init: function () {
                        updateBullets(this, paginationClass);
                    },
                    slideChange: function () {
                        updateBullets(this, paginationClass);
                    }
                }
            });
        }

        function updateBullets(swiper, paginationClass) {
            const bullets = document.querySelectorAll(`${paginationClass} .swiper-pagination-bullet`);

            bullets.forEach((b, i) => {
                b.classList.remove("filled");

                if (i < swiper.realIndex) {
                    b.classList.add("filled");
                }
            });
        }

    });
</script>

