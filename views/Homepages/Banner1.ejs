                    if (a !== audio) a.pause();
                });

                document.querySelectorAll(".music-card .play-btn").forEach(btn => {
                    if (btn !== playBtn) btn.innerHTML = `<i class="fa-solid fa-play"></i>`;
                });

                if (audio.paused) {
                    audio.play().catch(() => { });
                    playBtn.innerHTML = `<i class="fa-solid fa-pause"></i>`;
                } else {
                    audio.pause();
                    playBtn.innerHTML = `<i class="fa-solid fa-play"></i>`;
                }
            });

            audio.addEventListener("ended", () => {
                playBtn.innerHTML = `<i class="fa-solid fa-play"></i>`;
            });

            audio.addEventListener("play", () => {
                currentActiveIndex = -1;
                lyrics.forEach(line => line.classList.remove("active"));
            });

            audio.addEventListener("timeupdate", () => {

                if (!audio.duration) return;

                const remaining = audio.duration - audio.currentTime;
                const min = Math.floor(remaining / 60);
                const sec = Math.floor(remaining % 60);

                timeDisplay.textContent = `-${min}:${sec < 10 ? "0" : ""}${sec}`;

                lyrics.forEach((line, index) => {

                    const time = parseFloat(line.dataset.time);
                    const nextTime = lyrics[index + 1]
                        ? parseFloat(lyrics[index + 1].dataset.time)
                        : Infinity;

                    if (audio.currentTime >= time && audio.currentTime < nextTime) {

                        if (currentActiveIndex !== index) {

                            if (currentActiveIndex !== -1) {
                                lyrics[currentActiveIndex].classList.remove("active");
                            }

                            line.classList.add("active");
                            currentActiveIndex = index;

                            container.scrollTo({
                                top: line.offsetTop - container.clientHeight / 2,
                                behavior: "smooth"
                            });
                        }
                    }
                });
            });

        });

    });
</script>