            <% const accordionData=[ {
                title: "I want to build an NFT marketplace, but I don't know which chains to support or how to connect them."
                ,
                content: "We run a chain selection and architecture session in week one by mapping your target collector communities to the right chains."
                }, {
                title: "I've been quoted different prices by different development companies and have no realistic idea."
                ,
                content: "Our Cross-Chain NFT Marketplace Development cost breakdown is provided per component, and every line item maps to a deliverable."
                }, { title: "I need a cross-chain NFT bridge, but I'm worried about bridge security." ,
                content: "Every bridge contract Clarisco builds uses a non-custodial lock-and-mint with independent relayer validation."
                }, { title: "I already have an NFT marketplace on one chain, but I want to add cross-chain support." ,
                content: "Our cross-chain extension practice adds bridge and multi-chain smart contract support to existing NFT marketplace platforms."
                }, { title: "I want creator royalties enforced on every secondary sale, not just on my own marketplace."
                ,
                content: "We implement ERC-2981 royalty enforcement at the smart contract level as deducted and distributed in the settlement transaction itself."
                }, { title: "I need a white-label NFT marketplace I can launch under my own brand quickly." ,
                content: "Our white-label Cross Chain NFT Marketplace platform is pre-audited, fully configurable, and branded to your visual identity."
                }, { title: "I want to support fiat payments so non-crypto users can buy NFTs on my platform." ,
                content: "We integrate Stripe, MoonPay, and Transak fiat on-ramp services into the marketplace checkout flow."
                }, {
                title: "My NFT marketplace needs to handle high transaction volume during collection drops without slowing down."
                ,
                content: "We build marketplace backends on auto-scaling cloud with queue-based transaction processing and gas estimation caching."
                } ]; %>

                <section class="pb-5">
