                                                                                if (target) {
                                                                                    target.classList.add("ma-top");

                                                                                    target.scrollIntoView({
                                                                                        behavior: "smooth",
                                                                                        block: "start"
                                                                                    });
                                                                                }

                                                                                // allow scroll handler after anchor jump completes
                                                                                setTimeout(() => {
                                                                                    clickedNav = false;
                                                                                }, 500);
                                                                            });

                                                                        });

                                                                        window.addEventListener("wheel", () => {

                                                                            if (!clickedNav) {
                                                                                document.querySelectorAll(".ma-top").forEach(el => {
                                                                                    el.classList.remove("ma-top");
