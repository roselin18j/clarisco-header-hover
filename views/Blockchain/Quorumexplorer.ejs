<%- include('../common-new/header') %>

  <body>
    <%- include('../common-new/navbar') %>

        <section class="hero-section pb-5 new-header-padding-sec">
          <div class="container">
            <div class="row flex-lg-row-reverse align-items-center g-4">
              <div class="col-lg-6">
                <img
                  src="https://assets.clarisco.com/clarisco-images/blockchain/services/quorom-explorer/best-quorum-development-company.webp"
                  alt="best-quorum-development-company" />
              </div>
              <div class="col-lg-6">

                <h1 class="display-6 fw-bold lh-1 my-3">It's never been easier to sort through data on <span
                    class="fc-b">Quorum! </span></h1>
                <p>Our simple and powerful Quorum Explorer allows you to search through all data on
                  your network.</p>
                <div class="mt-5">
                  <button data-bs-toggle="modal" data-bs-target="#PopForm" class="nft-new-banner-button-1"
                    data-aos="fade-up">Get a Demo
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="border-bottom-new-design py-5">
          <div class="container">
            <div class="row align-items-center g-4">
              <div class="col-lg-6">
                <img
                  src="https://assets.clarisco.com/clarisco-images/blockchain/services/quorom-explorer/best-quorum-explorer-development-company.webp"
                  alt="best-quorum-explorer-development-company" />
              </div>
              <div class="col-lg-6">
                <h2 class="mb-4">What is the Work of a Quorum Explorer?</h2>
                <p>A reporting tool is needed to deal with data from blockchains like Quorum, which
                  are increasingly
                  being used in different industries. Quorum Explorer is made up of two components: a dashboard, and a
                  blockchain analyzer. The dashboard provides a simple interface that allows the user to quickly access
                  different options such as new blocks and recent transactions. The blockchain analyzer allows the user
                  to search for stored data by using different sorting parameters.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="py-5 border-bottom-new-design">
          <div class="container">
            <h2 class="text-center mb-3">Quorum Explorer Functions</h2>
            <p class="text-center mb-5">We offer the following functions on our Quorum Explorer solutions.
            </p>
            <div class="row row-cols-1 row-cols-lg-4 g-4">
              <div class="col">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa-solid fa-layer-group fs-24 fc-b"></i>
                    <h5 class="card-title mt-2">Block List</h5>
                    <p class="card-text">You can track and view all the blocks being mined, as well as old
                      blocks, in real-time.</p>
                  </div>
                </div>
              </div>
              <div class="col">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa-solid fa-layer-group fs-24 fc-b"></i>
                    <h5 class="card-title mt-2">Transaction List</h5>
                    <p class="card-text">You can check details about public transactions and private
                      transactions that were made on the network.</p>
                  </div>
                </div>
              </div>
              <div class="col">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa-solid fa-layer-group fs-24 fc-b"></i>
                    <h5 class="card-title mt-2">Address List</h5>
                    <p class="card-text">Check the transactions and history associated with each address.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa-solid fa-layer-group fs-24 fc-b"></i>
                    <h5 class="card-title mt-2">Smart Contract List</h5>
                    <p class="card-text">Take a look at the various contracts that are part of the
                      blockchain.</p>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </section>

        <section class="py-5  border-bottom-new-design">
          <div class="container">
            <div class="row">
              <div class="col-lg-10 mx-auto">
                <div class="card border-0 bg-t text-center">
                  <div class="card-body py-5">
                    <h2><span class="fc-b">Analytics Integrations</span></h2>
                    <p class="card-text my-3">A premium data analytics function is also available
                      that can be tailored to gather information based upon the metrics you provide. Contact us for more
                      details.</p>
                    <button data-bs-toggle="modal" data-bs-target="#PopForm" class="btn btn-outline-light btn-md mt-2">Talk With Our Experts</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="py-5 border-bottom-new-design">
          <div class="container">
            <h2 class="text-center mb-3">Advantages of Quorum Explorer</h2>
            <p class="text-center mb-5">Our solution gives you these benefits:</p>
            <div class="row row-cols-1 row-cols-lg-3 g-4">
              <div class="col">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa-solid fa-layer-group fs-24 fc-b"></i>
                    <h5 class="card-title mt-2">Speed</h5>
                    <p class="card-text">In a matter of seconds, you can pull records of transactions and
                      blocks.</p>
                  </div>
                </div>
              </div>
              <div class="col">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa-solid fa-layer-group fs-24 fc-b"></i>
                    <h5 class="card-title mt-2">It's easy</h5>
                    <p class="card-text">All data can be viewed in an easy-to-use and concise manner.</p>
                  </div>
                </div>
              </div>
              <div class="col">
                <div class="card h-100">
                  <div class="card-body">
                    <i class="fa-solid fa-layer-group fs-24 fc-b"></i>
                    <h5 class="card-title mt-2">Accessibility</h5>
                    <p class="card-text">You can easily manage data storage in your network.</p>
                  </div>
                </div>
              </div>


            </div>
          </div>
        </section>

        <section class="py-5  border-bottom-new-design">
          <div class="container">
            <div class="row">
              <div class="col-lg-10 mx-auto">
                <div class="card border-0 bg-t text-center">
                  <div class="card-body py-5">
                    <h2><span class="fc-b">Why work with us?</span></h2>
                    <p class="card-text my-3">Clarisco Solution's is a leader in technology
                      solutions. We have collaborated with many industry leaders and launched several successful
                      projects. Our solutions are 100% customizable and white-labelled. This gives you an edge over your
                      competitors. Our top developers integrate the most recent trends into our products.</p>
                    <button data-bs-toggle="modal" data-bs-target="#PopForm" class="btn btn-outline-light btn-md mt-2">Talk With Our Experts</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="py-5 border-bottom-new-design">
          <div class="container">
            <h2 class="text-center mb-5">FAQ(Frequently Asked Question)</h2>
            <div class="accordion" id="accordionExample">
              <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                  <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne"
                    aria-expanded="true" aria-controls="collapseOne">
                    Does the Quorum Explorer offer additional sorting options?
                  </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne"
                  data-bs-parent="#accordionExample">
                  <div class="accordion-body">
                    We are currently working to improve and integrate new filter metrics for the explorer. Keep up to
                    date with the latest updates by following us on social media.
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header" id="headingTwo">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                    Can this service be used to manage my private Quorum Protocol?
                  </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo"
                  data-bs-parent="#accordionExample">
                  <div class="accordion-body">
                    Yes! You can integrate our free solution to manage your Quorum Blockchain effectively.
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header" id="headingThree">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                    Can the explorer be customized to collect data?
                  </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree"
                  data-bs-parent="#accordionExample">
                  <div class="accordion-body">
                    Quorum Explorer is also available in a paid edition that doubles as a data analysis tool. The
                    service can be customized to track data according to your preferences. Get in touch with us for more
                    information
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header" id="headingFour">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                    What technologies have been used to create this solution?
                  </button>
                </h2>
                <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour"
                  data-bs-parent="#accordionExample">
                  <div class="accordion-body">
                    The Quorum Explorer was developed using software such as PHP and Node.js.
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header" id="headingFive">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                    Does your company offer customized reporting tools for other blockchain protocol protocols?
                  </button>
                </h2>
                <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive"
                  data-bs-parent="#accordionExample">
                  <div class="accordion-body">
                    We are currently developing plans to build explorers for other Blockchain networks. Get in touch
                    with us for more information!
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      <%- include('../common-new/footer') %>
  </body>

  </html>