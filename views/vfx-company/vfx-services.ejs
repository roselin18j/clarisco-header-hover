                <script>
                    $(document).ready(function () {
                        $(".top-newbar-section .navbar .uniqueoffcanvas").addClass("hide-nav-12");
                        $(".top-home-new-social-fixed").addClass("hide-content");


                        $(window).scroll(function () {
                            var wscroll = $(this).scrollTop();
                            if (wscroll > 50) {
                                $(".top-newbar-section .navbar .uniqueoffcanvas").removeClass("hide-nav-12");
                                $(".top-newbar-section .navbar .uniqueoffcanvas").addClass("show-nav-12");
                                $(".top-home-new-social-fixed").addClass("show-content");
                                $(".top-home-new-social-fixed").removeClass("hide-content");
                            }
                            else {
                                $(".top-newbar-section .navbar .uniqueoffcanvas").addClass("hide-nav-12");
                                $(".top-newbar-section .navbar .uniqueoffcanvas").removeClass("show-nav-12");
                                $(".top-home-new-social-fixed").addClass("hide-content");
                                $(".top-home-new-social-fixed").removeClass("show-content");
                            }
                        });
                    });
                </script>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        var swiper = new Swiper(".vfx-mySwiper", {
                            loop: true,
                            navigation: {
                                nextEl: "#next_slide",
                                prevEl: "#prev_slide",
                            },
                            pagination: {
                                el: ".swiper-pagination",
                                clickable: true,
                            },
                            slidesPerView: 1,
                            spaceBetween: 10,

                            breakpoints: {
                                640: {
                                    slidesPerView: 1,
                                    spaceBetween: 20,
                                },
                                768: {
                                    slidesPerView: 2,
                                    spaceBetween: 40,
                                },
                                992: {
                                    slidesPerView: 4,
                                    spaceBetween: 50,
                                },
                                1024: {
                                    slidesPerView: 4,
                                    spaceBetween: 50,
                                },
                            },
                        });
                    });
                </script>
                <script>
                    document.addEventListener('DOMContentLoaded', (event) => {
                        const video = document.getElementById('myVideo');

                        video.addEventListener('click', () => {
                            video.controls = true; // Show video controls
                            video.autoplay = true;
                        });
                    });

                </script>





