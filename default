####################################
# 🚫 BLOCK COMMON ATTACK PATHS
####################################
# Block PHP completely (if not using PHP)
location ~* \.php$ {
    return 444;
}

# WordPress attacks
location ~* /(wp-admin|wp-login|wp-content|wp-includes|xmlrpc\.php) {
    return 444;
}

# phpMyAdmin
location ~* /(phpmyadmin|pma|myadmin) {
    return 444;
}

# Environment & config leaks
location ~* /\.(env|git|svn|htaccess|htpasswd|DS_Store) {
    return 444;
}

# Backup & config files
location ~* \.(bak|old|backup|sql|conf|config|ini|log|sh|swp|dist)$ {
    return 444;
}

# Sensitive system files
location ~* /(etc/passwd|proc/self/environ) {
    return 444;
}

# Node/JS sensitive files
location ~* /(package\.json|package-lock\.json|yarn\.lock) {
    return 444;
}

# Laravel & framework paths
location ~* /(vendor|storage|bootstrap|\.idea) {
    return 444;
}

# Common shell names
location ~* /(shell|cmd|upload|uploader|backdoor|adminer)\.php {
    return 444;
}



